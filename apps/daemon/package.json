    "@workforce/artifacts": "workspace:*",
    "@workforce/config": "workspace:*",
    "@workforce/database": "workspace:*",
    "@workforce/domain": "workspace:*",
    "@workforce/events": "workspace:*",
    "@workforce/policy": "workspace:*",
    "@workforce/process": "workspace:*",
    "@workforce/protocol": "workspace:*",
    "@workforce/runtime-claude-code": "workspace:*",
    "@workforce/runtime-codex": "workspace:*",
    "@workforce/runtime-mock": "workspace:*",
    "@workforce/runtime-sdk": "workspace:*",
    "@workforce/runtime-spi": "workspace:*",
    "@workforce/workflow-engine": "workspace:*",
    "@workforce/workspace": "workspace:*",
    "fastify": "5.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
